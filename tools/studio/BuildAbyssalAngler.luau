--[[
	Sample VoxelMorph creature: Abyssal Angler [Epic, Saltwater].
	Matches reference/visual assets.jpeg (head + jaw, body, tail base, tail fin,
	pectoral fins, dorsal spines, glowing lure) and the rig standard in GDD §6.

	HOW TO RUN (edit mode): pass this file to the Studio MCP `run_code` tool, or
	paste it into the Command Bar. It creates no scripts. Output:

	  ReplicatedStorage/Assets/Creatures/Saltwater/AbyssalAngler   (Model)
	    RootPart      invisible, PrimaryPart, holds AuraAttachment
	    Body          Motor6D "Body"      RootPart -> Body
	    Head          Motor6D "Head"      Body -> Head
	    Jaw           Motor6D "Jaw"       Head -> Jaw       (hinge at the jaw's back edge)
	    Tail          Motor6D "Tail"      Body -> Tail      (tail base)
	    TailFin       Motor6D "TailFin"   Tail -> TailFin
	    LeftFin       Motor6D "LeftFin"   Body -> LeftFin
	    RightFin      Motor6D "RightFin"  Body -> RightFin
	    DorsalFin     Motor6D "DorsalFin" Body -> DorsalFin
	    Lure          Motor6D "Lure"      Head -> Lure

	Rig rules every VoxelMorph creature follows:
	  * Faces -Z. Authored at 1.0x scale (the client applies ModelScale).
	  * Each Motor6D is named after its Part1 and lives in its Part0; C0/C1 place
	    the pivot at the joint, so Motor6D.Transform rotates about the hinge.
	  * "Bone" parts are direct children of the Model. Decorative voxels are
	    children of their bone, joined by WeldConstraints, so they follow it.
	  * Only RootPart is anchored. Nothing collides.
	  * Neon parts are authored glow (eyes, lure) and are left alone by mutation
	    tinting; parts under *Fin bones and Lure take a mutation's neon colour.
]]

local ChangeHistoryService = game:GetService("ChangeHistoryService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SPECIES_ID = "AbyssalAngler"
local BIOME = "Saltwater"

local C = {
	Body = Color3.fromRGB(44, 34, 78),
	BodyDark = Color3.fromRGB(30, 24, 56),
	Belly = Color3.fromRGB(96, 70, 150),
	Fin = Color3.fromRGB(122, 84, 190),
	FinRay = Color3.fromRGB(170, 120, 235),
	Mouth = Color3.fromRGB(150, 50, 90),
	Tooth = Color3.fromRGB(240, 226, 170),
	Glow = Color3.fromRGB(120, 230, 255),
	Pupil = Color3.fromRGB(12, 10, 22),
}

local function ensureFolder(parent, name)
	local found = parent:FindFirstChild(name)
	if not found then
		found = Instance.new("Folder")
		found.Name = name
		found.Parent = parent
	end
	return found
end

local assets = ensureFolder(ReplicatedStorage, "Assets")
local creatures = ensureFolder(assets, "Creatures")
ensureFolder(creatures, "Freshwater")
local biomeFolder = ensureFolder(creatures, BIOME)

local previous = biomeFolder:FindFirstChild(SPECIES_ID)
if previous and previous:GetAttribute("GeneratedBy") ~= "BuildAbyssalAngler" then
	error(`{SPECIES_ID} already exists and was not generated by this script - rename or remove it first.`)
end

local recording = ChangeHistoryService:TryBeginRecording("Build Abyssal Angler rig")
if previous then
	previous:Destroy()
end

local model = Instance.new("Model")
model.Name = SPECIES_ID
model:SetAttribute("SpeciesId", SPECIES_ID)
model:SetAttribute("RigVersion", 1)
model:SetAttribute("GeneratedBy", "BuildAbyssalAngler")

local voxelCount = 0

local function block(name, size, position, color, parent, neon)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(position)
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Parent = parent
	voxelCount += 1
	return p
end

-- A decorative voxel that rides on a bone.
local function voxel(bone, name, size, position, color, neon)
	local p = block(name, size, position, color, bone, neon)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bone
	weld.Part1 = p
	weld.Parent = p
	return p
end

local function joint(part0, part1, pivot)
	local motor = Instance.new("Motor6D")
	motor.Name = part1.Name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = part0.CFrame:ToObjectSpace(CFrame.new(pivot))
	motor.C1 = part1.CFrame:ToObjectSpace(CFrame.new(pivot))
	motor.Parent = part0
	return motor
end

local V = Vector3.new

-- RootPart --------------------------------------------------------------------------
local root = block("RootPart", V(3.2, 3.6, 8), V(0, 0.2, 0.4), C.Body, model)
root.Transparency = 1
root.Anchored = true
model.PrimaryPart = root

local aura = Instance.new("Attachment")
aura.Name = "AuraAttachment"
aura.Parent = root

-- Body ------------------------------------------------------------------------------
local body = block("Body", V(2.6, 2.6, 2.6), V(0, 0, 0.3), C.Body, model)
voxel(body, "Belly", V(2.2, 0.5, 2.3), V(0, -1.4, 0.3), C.Belly)
voxel(body, "Back", V(1.8, 0.4, 2.2), V(0, 1.45, 0.3), C.BodyDark)
for _, side in { -1, 1 } do
	-- Raised scale plates down each flank.
	voxel(body, "Scale", V(0.2, 0.9, 0.7), V(side * 1.35, 0.5, -0.4), C.Belly)
	voxel(body, "Scale", V(0.2, 0.7, 0.7), V(side * 1.35, 0.2, 0.5), C.Belly)
	voxel(body, "Scale", V(0.2, 0.5, 0.6), V(side * 1.35, -0.1, 1.3), C.Belly)
end

-- Head ------------------------------------------------------------------------------
local head = block("Head", V(2.9, 2.3, 1.6), V(0, 0.35, -1.8), C.Body, model)
voxel(head, "Brow", V(3.1, 0.5, 0.9), V(0, 1.35, -2.0), C.BodyDark)
voxel(head, "Snout", V(2.5, 1.2, 0.6), V(0, 0.5, -2.9), C.Body)
voxel(head, "MouthRoof", V(2.3, 0.3, 1.8), V(0, -0.85, -2.1), C.Mouth)
for _, side in { -1, 1 } do
	voxel(head, "Eye", V(0.2, 0.7, 0.7), V(side * 1.5, 0.7, -2.1), C.Glow, true)
	voxel(head, "Pupil", V(0.24, 0.3, 0.3), V(side * 1.52, 0.7, -2.2), C.Pupil)
	voxel(head, "Gill", V(0.2, 1.2, 0.3), V(side * 1.5, 0.1, -1.2), C.BodyDark)
end
-- Upper teeth: uneven needle fangs along the front and sides.
local upperHeights = { 0.9, 0.6, 1.0, 0.6, 0.9 }
for index, height in upperHeights do
	local x = -1.0 + (index - 1) * 0.5
	voxel(head, "ToothUpper", V(0.22, height, 0.22), V(x, -0.85 - height / 2, -3.05), C.Tooth)
end
for _, side in { -1, 1 } do
	voxel(head, "ToothUpper", V(0.22, 0.6, 0.22), V(side * 1.25, -1.1, -2.6), C.Tooth)
	voxel(head, "ToothUpper", V(0.22, 0.5, 0.22), V(side * 1.25, -1.05, -2.0), C.Tooth)
end

-- Jaw (underbite, hinged at its back edge) ----------------------------------------------
local jaw = block("Jaw", V(3.0, 0.7, 2.6), V(0, -1.75, -2.1), C.BodyDark, model)
voxel(jaw, "Tongue", V(2.0, 0.2, 1.8), V(0, -1.35, -2.1), C.Mouth)
voxel(jaw, "Chin", V(2.2, 0.4, 1.4), V(0, -2.2, -2.0), C.Belly)
local lowerHeights = { 0.8, 1.1, 0.7, 0.7, 1.1, 0.8 }
for index, height in lowerHeights do
	local x = -1.25 + (index - 1) * 0.5
	voxel(jaw, "ToothLower", V(0.22, height, 0.22), V(x, -1.4 + height / 2, -3.3), C.Tooth)
end
for _, side in { -1, 1 } do
	voxel(jaw, "ToothLower", V(0.22, 0.7, 0.22), V(side * 1.38, -1.05, -2.7), C.Tooth)
	voxel(jaw, "ToothLower", V(0.22, 0.5, 0.22), V(side * 1.38, -1.15, -2.1), C.Tooth)
end

-- Tail base + tail fin --------------------------------------------------------------------
local tail = block("Tail", V(1.6, 1.7, 1.0), V(0, 0, 2.1), C.Body, model)
voxel(tail, "TailBelly", V(1.2, 0.3, 0.9), V(0, -0.9, 2.1), C.Belly)

local tailFin = block("TailFin", V(0.3, 1.6, 0.7), V(0, 0, 2.95), C.Fin, model)
voxel(tailFin, "FinRay", V(0.25, 0.8, 0.9), V(0, 1.0, 3.5), C.FinRay)
voxel(tailFin, "FinRay", V(0.25, 0.8, 0.9), V(0, -1.0, 3.5), C.FinRay)
voxel(tailFin, "FinRay", V(0.25, 0.6, 0.6), V(0, 1.6, 3.9), C.Fin)
voxel(tailFin, "FinRay", V(0.25, 0.6, 0.6), V(0, -1.6, 3.9), C.Fin)
voxel(tailFin, "FinWeb", V(0.2, 1.2, 0.5), V(0, 0, 3.4), C.Fin)

-- Pectoral fins ---------------------------------------------------------------------------
local leftFin = block("LeftFin", V(1.2, 0.25, 0.9), V(-1.9, -0.6, -0.1), C.Fin, model)
voxel(leftFin, "FinRay", V(0.7, 0.2, 0.6), V(-2.75, -0.7, 0.2), C.FinRay)
local rightFin = block("RightFin", V(1.2, 0.25, 0.9), V(1.9, -0.6, -0.1), C.Fin, model)
voxel(rightFin, "FinRay", V(0.7, 0.2, 0.6), V(2.75, -0.7, 0.2), C.FinRay)

-- Dorsal spines -----------------------------------------------------------------------------
local dorsal = block("DorsalFin", V(0.3, 0.5, 2.0), V(0, 1.85, 0.4), C.Fin, model)
local spineHeights = { 1.0, 1.5, 1.2, 0.8 }
for index, height in spineHeights do
	local z = -0.35 + (index - 1) * 0.5
	voxel(dorsal, "Spine", V(0.25, height, 0.3), V(0, 2.1 + height / 2, z), C.FinRay)
end

-- Lure (illicium): stalk arcs forward over the head and ends in a glowing bulb ---------------
local lure = block("Lure", V(0.3, 1.3, 0.3), V(0, 2.15, -1.7), C.BodyDark, model)
voxel(lure, "Stalk", V(0.3, 0.3, 1.0), V(0, 2.95, -2.2), C.BodyDark)
voxel(lure, "Stalk", V(0.3, 0.3, 0.6), V(0, 2.75, -2.95), C.BodyDark)
voxel(lure, "Stalk", V(0.25, 0.6, 0.25), V(0, 2.35, -3.3), C.BodyDark)
local bulb = voxel(lure, "Bulb", V(0.7, 0.7, 0.7), V(0, 1.75, -3.3), C.Glow, true)
local light = Instance.new("PointLight")
light.Name = "LureLight"
light.Color = C.Glow
light.Range = 10
light.Brightness = 2.5
light.Parent = bulb

-- Motor6D joints (pivot = the hinge point) ------------------------------------------------------
joint(root, body, V(0, 0, 0.3))
joint(body, head, V(0, 0.2, -1.0))
joint(head, jaw, V(0, -1.4, -0.9))
joint(body, tail, V(0, 0, 1.6))
joint(tail, tailFin, V(0, 0, 2.6))
joint(body, leftFin, V(-1.3, -0.6, -0.1))
joint(body, rightFin, V(1.3, -0.6, -0.1))
joint(body, dorsal, V(0, 1.3, 0.4))
joint(head, lure, V(0, 1.5, -1.7))

model.Parent = biomeFolder

if recording then
	ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
end

local motors = 0
for _, descendant in model:GetDescendants() do
	if descendant:IsA("Motor6D") then
		motors += 1
	end
end
print(
	`[BuildAbyssalAngler] {model:GetFullName()} built: {voxelCount} parts, {motors} Motor6D joints, AuraAttachment on RootPart.`
)
